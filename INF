:root{
  --brand:#003366;
  --accent:#00509e;
  --muted:#f4f7fb;
  --white:#fff;
  --text:#0b2340;
  --radius:8px;
}

*{box-sizing:border-box}
body{
  font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  margin:0; color:var(--text); background:var(--muted); line-height:1.6;
}
.container{max-width:1000px; margin:0 auto; padding:20px;}
.site-header{background:var(--brand); color:var(--white);}
.header-inner{display:flex; align-items:center; justify-content:space-between; padding:12px 20px;}
.brand{display:flex; align-items:center; gap:10px; text-decoration:none; color:inherit;}
.brand img{height:44px;}
.nav a{color:var(--white); margin-left:14px; text-decoration:none}
.menu-toggle{display:none; background:transparent; border:0; color:var(--white); font-size:18px}

/* Hero */
.hero{background:linear-gradient(90deg,var(--brand),var(--accent)); color:var(--white); padding:60px 20px; text-align:center;}
.hero h1{margin:0 0 10px; font-size:28px}
.btn{background:var(--white); color:var(--brand); padding:10px 18px; border-radius:6px; text-decoration:none; display:inline-block; margin-top:12px}

/* Features */
.features{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; margin-top:28px}
.features article{background:var(--white); padding:16px; border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,.06)}

/* CTA */
.cta{background:var(--white); padding:20px; margin-top:20px; text-align:center; border-radius:8px}

/* Footer */
.site-footer{background:var(--brand); color:var(--white); padding:12px; text-align:center; margin-top:28px}

/* Forms */
.form{background:var(--white); padding:16px; border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,.06)}
.form label{display:block; margin:10px 0 6px}
.form input, .form select, .form textarea{width:100%; padding:8px; border-radius:6px; border:1px solid #d7e2ef}

/* Responsive */
@media (max-width:800px){
  .header-inner{flex-direction:row}
  .nav{position:relative}
  .nav a{display:none}
  .menu-toggle{display:inline-block}
  .nav.open a{display:block; margin:10px 0; background:transparent; color:var(--white)}
}
// basic interactivity: mobile nav toggle + simple form confirmation
document.addEventListener('DOMContentLoaded', function(){
  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  if(menuToggle){
    menuToggle.addEventListener('click', ()=> {
      nav.classList.toggle('open');
    });
  }

  // success confirmation for forms using client-side intercept if action is Formspree (optional)
  const forms = document.querySelectorAll('form');
  forms.forEach(form => {
    form.addEventListener('submit', (e) => {
      // let real submit happen; if you want AJAX, implement fetch here.
      // small UX improvement: show a native confirm
      const submitBtn = form.querySelector('button[type="submit"]');
      if(submitBtn){
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting...';
      }
    });
  });
});
